#!/usr/bin/env sh
set -eu

# healthcheck-fcron: verifies that fcron daemon is running.
# Returns 0 when healthy, non-zero otherwise.

# Configuration paths (must match fcron.conf in the image)
PIDFILE="/usr/local/var/run/fcron.pid"

# Check PID file exists
if [ ! -f "$PIDFILE" ]; then
  echo "fcron pidfile not found: $PIDFILE" 1>&2
  exit 1
fi

# Read first token from pidfile and validate it's numeric
PID="$(awk 'NR==1{print $1}' "$PIDFILE" 2>/dev/null || true)"
case "$PID" in
  ''|*[!0-9]*)
    echo "invalid pid in $PIDFILE: '$PID'" 1>&2
    exit 1
    ;;
 esac

# Check process liveness
if ! kill -0 "$PID" 2>/dev/null; then
  echo "fcron process not running (pid: $PID)" 1>&2
  exit 1
fi

exit 0
