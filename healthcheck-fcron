#!/usr/bin/env sh
set -eu

# healthcheck-fcron: verifies that fcron daemon is running.
# Returns 0 when healthy, non-zero otherwise.

# Configuration paths (must match fcron.conf in the image)
PIDFILE="/usr/local/var/run/fcron.pid"

# Check PID file exists and process is alive
if [ ! -f "$PIDFILE" ]; then
  echo "fcron pidfile not found: $PIDFILE" 1\>\&2
  exit 1
fi
PID="$(cat "$PIDFILE" 2\>\/dev\/null || true)"
if [ -z "$PID" ] || ! kill -0 "$PID" 2\>\/dev\/null; then
  echo "fcron process not running (pid: $PID)" 1\>\&2
  exit 1
fi

exit 0

